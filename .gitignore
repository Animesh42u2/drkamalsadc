dist
dist-ssr
build
*.local

# ── Environment variables ────────────────────────────────────
# Never commit real secrets (e.g. GOOGLE_PLACES_API_KEY, GOOGLE_PLACE_ID).
# Keep a checked-in .env.example instead, with placeholder values, so
# collaborators know which vars they need to set.
.env
.env.local
.env.*.local
.env.development
.env.production

# ── Vercel ────────────────────────────────────────────────────
.vercel

# ── Logs ──────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

